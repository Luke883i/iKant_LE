{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ikant-le-external": {
      "type": "streamable-http",
      "url": "https://replace-with-your-deployed-host.example/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "baseScopes": ["ikant:connect"]
          }
        }
      }
    }
  }
}
