{
  "schema": "ikant-le-session-chat-local-host-kernel/v3",
  "slice": "C59.SINGLE_COMPOSITION_CHANNEL",
  "authority": 0,
  "composition_contract": "contracts/session-chat-composition-channel.json",
  "live_channel_census": "contracts/session-chat-composition-census.json",
  "repository": {
    "full_name": "Luke883i/iKant_LE",
    "url": "https://github.com/Luke883i/iKant_LE",
    "branch": "main",
    "source_head_binding": "GITHUB_API_EXACT_MAIN_HEAD_ONCE"
  },
  "trigger": {
    "event": "ANY_FIRST_USER_INPUT",
    "action": "START_FROM_REPO",
    "before_substantive_response": true,
    "preserve_pending_intent": "BYTE_EXACT"
  },
  "action_program": [
    {
      "id": "000",
      "name": "START_FROM_REPO",
      "owner": "HOST_ADAPTER",
      "effect": "BEGIN_CANONICAL_REPOSITORY_BOOTSTRAP"
    },
    {
      "id": "100",
      "name": "BIND_SOURCE",
      "owner": "REPOSITORY_TRANSPORT",
      "transport": "GITHUB_API_ONLY",
      "output": "SOURCE_HEAD"
    },
    {
      "id": "110",
      "name": "READ_ORIENTATION",
      "owner": "REPOSITORY_TRANSPORT",
      "paths": [
        "README.md",
        "BOOTSTRAP.json",
        "ADMISSION.json",
        "AGENTS.md",
        "TERMS.md"
      ],
      "exact_ref": "SOURCE_HEAD"
    },
    {
      "id": "120",
      "name": "PRESENT_TERMS",
      "owner": "TERMS.md",
      "effect": "PRESENT_EXACT_TERMS"
    },
    {
      "id": "130",
      "name": "FREEZE",
      "owner": "HOST_ADAPTER",
      "effect": "FREEZE_PREACCEPT_ACQUISITION"
    },
    {
      "id": "140",
      "name": "WAIT_ACCEPTANCE",
      "owner": "ADMISSION",
      "exact_input": "I ACCEPT",
      "type": "STOP"
    },
    {
      "id": "200",
      "name": "ACCEPT",
      "owner": "ADMISSION",
      "effect": "REUSE_FROZEN_SOURCE_AND_PENDING_INTENT"
    },
    {
      "id": "300",
      "name": "ACTIVATE_FIRST",
      "owner": "SESSION_CHAT_COMPOSITION_CHANNEL",
      "contract": "contracts/session-chat-composition-channel.json",
      "one_path": true,
      "transport": "GITHUB_API_BASE64",
      "byte_path": "VERIFIED_OPAQUE_RELAY",
      "container_github_network_required": false,
      "model_selects_carrier": false,
      "model_selects_fallback": false,
      "owner_module": "src/session-chat-composition.mjs#issueCanonicalSessionChatComposition",
      "authority_gate": "src/session-chat-composition.mjs#validateCanonicalCompositionHandoff",
      "canonical_handoff_schema": "ikant-le-c59-canonical-composition-handoff/v1",
      "legacy_handoff_may_authorize": false
    },
    {
      "id": "310",
      "name": "MATERIALIZE_LOCAL",
      "owner": "LOCAL_EXECUTOR_V1",
      "allowed_only_after_acceptance": true,
      "content_addressed_runtime_root": true,
      "readback_required": true,
      "executed_provenance_required": true,
      "live_probe_required": true
    },
    {
      "id": "400",
      "name": "RUNTIME_ROUTE",
      "owner": "LOCAL_RUNTIME",
      "allowed_only_after_active": true
    },
    {
      "id": "900",
      "name": "EXIT",
      "owner": "LOCAL_RUNTIME",
      "exact_input": "EXIT IKANT"
    },
    {
      "id": "990",
      "name": "EDGE_STOP",
      "owner": "CURRENT_EDGE",
      "scope": "CURRENT_EDGE_ONLY",
      "type": "STOP"
    }
  ],
  "preaccept": {
    "transport": "GITHUB_API_ONLY",
    "materialize_local": false,
    "generic_discovery": false
  },
  "postaccept": {
    "mode": "SINGLE_COMPOSITION_CHANNEL",
    "source_plane": "GITHUB_API",
    "cold_transport": "GITHUB_API_BASE64",
    "byte_path": "VERIFIED_OPAQUE_RELAY",
    "sink_plane": "SESSION_LOCAL_FILESYSTEM",
    "execution_plane": "SESSION_LOCAL_NODE",
    "container_github_network_required": false,
    "runtime_root_exact_source": true,
    "probe_required": true,
    "active_readback_required": true,
    "resume_pending_after_active_only": true,
    "canonical_owner": "src/session-chat-composition.mjs#issueCanonicalSessionChatComposition",
    "canonical_handoff_schema": "ikant-le-c59-canonical-composition-handoff/v1",
    "legacy_fastboot_handoff_authority": false
  },
  "negative_controls": {
    "repository_symbol_is_host_capability": false,
    "tool_presence_is_success": false,
    "tool_absence_is_carrier_unavailable": false,
    "unknown_is_false": false,
    "chat_is_ledger": false,
    "model_may_invent_receipts": false,
    "model_may_emulate_owner_from_source": false,
    "model_may_select_legacy_carrier": false,
    "container_github_network_is_bootstrap_dependency": false,
    "unclassified_live_channel_allowed": false,
    "future_blocker_search": false,
    "substitute_ikant_output": false,
    "legacy_fastboot_handoff_may_authorize": false
  },
  "prompt_form": {
    "style": "COBOL_LIKE_NATURAL_LANGUAGE",
    "flat_sections": true,
    "indentation": false,
    "named_actions": true,
    "named_stops": true,
    "single_assignment_semantics": true
  },
  "qualification": {
    "selection_cases": 1024,
    "adversarial_cases": 100000,
    "all_live_channels_classified": true,
    "unique_minimum_required": true,
    "surviving_harmful_mutants_required": 0,
    "canonical_authority_gate_required": true
  }
}
