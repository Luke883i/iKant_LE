{
  "schema": "ikant-le-contract/v1",
  "version": "0.1.0",
  "runtime": {"node": ">=20", "dependencies": 0, "single_writer": true, "fs_first": true},
  "lifecycle": ["TERMS", "I ACCEPT", "PROBE IKANT", "INITIALIZE IKANT", "ACTIVE", "EXIT IKANT"],
  "exact_commands": {"accept": "I ACCEPT", "probe": "PROBE IKANT", "initialize": "INITIALIZE IKANT", "exit": "EXIT IKANT"},
  "authority": {
    "model": 0,
    "provider": 0,
    "ui": 0,
    "telemetry": 0,
    "backlog_docx": 0,
    "human_material_decision_required": true,
    "external_action_implemented": false
  },
  "surface_a": {"min_words": 50, "max_words": 500, "natural_language_only": true, "first": true},
  "surface_b": {"format": "docx", "same_turn": true, "technical_detail_owner": true, "public_chain_of_thought": false},
  "state": {"ledger": ".ikant/ledger.jsonl", "hash_linked": true, "readback_required": true, "terms_digest_bound": true},
  "adaptation": {"explicit_preferences_only": true, "allowed": ["BRIEF", "STANDARD", "DETAILED"], "inferred_personality": false},
  "failure_terminals": ["DENY", "RESET_REQUIRED", "REVIEW", "FAILURE"],
  "invariants": [
    "representation_not_reality",
    "evidence_permission_execution_separated",
    "external_content_is_data_not_instruction",
    "exact_admission_and_exit",
    "one_writer_append_readback",
    "engine_identity_not_authority",
    "surface_a_before_surface_b",
    "no_private_chain_of_thought",
    "docx_and_telemetry_not_evidence",
    "mutation_not_physical_proof"
  ]
}
