    "public_reasons_only": true,
    "persisted": false,
    "prose_reingested": false,
    "private_chain_of_thought": false,
    "behavior_is_conditioned_by": "PERSISTED_STATE_AND_RUNTIME_TIER_NOT_SUMMARY_PROSE"
