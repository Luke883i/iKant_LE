    "artifact_readback_before_frame_release": true
  },
  "release": {
    "atomic_session_frame": true,
    "visual_order_is_not_causal_order": true,
    "structured_session_shell_required": true
  },
  "ownership": {
    "new_lifecycle": false,
    "new_writer": false,
    "new_status_state": false,
    "new_persisted_self_message": false,
    "model_authority": 0
