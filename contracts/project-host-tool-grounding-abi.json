{
  "schema": "ikant-host-tool-grounding-abi/v1",
  "authority": 0,
  "active": false,
  "execution": "HOST_DRIVEN_ONLY",
  "read_scope": "POST_ACCEPT_ONLY",
  "source_of_truth": "BOOTSTRAP.project_session + original C72/H1/E16/K0/K1",
  "purpose": "Eliminate unsupported assumptions about tool names, Node DNS and automatic cross-tool bridge; make Host execute observable source carrier before STOP.",
  "immutable_boundaries": {
    "first_turn": "ONLY_HEAD_AND_FIVE_PINNED_DOCUMENTS_NO_EXTRA_SOURCE_OR_CODE",
    "consent": "DISTINCT_EXACT_I_ACCEPT_AFTER_TERMS",
    "mode": "ANOTHER_DISTINCT_EXACT_EDU",
    "original_owners": [
