      "id": "GITHUB_SOURCE",
      "role": "read HEAD + pinned original Git blobs",
      "binding": "EXISTING_CALLABLE_GITHUB_CONNECTOR_OR_EQUIVALENT",
      "witness": "TOOL_RESULT_OBSERVED_IN_THIS_CHAT",
      "unknown": "STOP_TOOL_UNBOUND"
