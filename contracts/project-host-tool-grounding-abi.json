      "on_unknown": "STOP_K1_SOURCE_CALLBACKS_UNBOUND"
    },
    {
      "id": "HOST_SOURCE_PACKET",
      "rank": 3,
      "requires": [
        "GITHUB_SOURCE",
        "NODE_EXEC"
      ],
      "receiver": "host/project-c72-e16-unified-ingress.mjs#runC72ProjectE16Ingress",
      "physical_protocol": "Authenticated 8-blob packet + original transitSourcePacket + original seed from verified commit",
      "on_unknown": "STOP_E16_CARRIER_NORMALIZATION_REQUIRED"
    },
    {
      "id": "NODE_GITHUB_HTTPS",
      "rank": 4,
      "requires": [
        "NODE_EXEC"
      ],
      "receiver": "host/project-c72-physical-ingress.mjs",
      "physical_protocol": "Only after actual positive HTTPS probe; known Node DNS failure does not exclude HOST_TOOL_ARG_RELAY",
      "on_unknown": "STOP_NODE_HTTPS_UNBOUND"
    }
  ],
  "gold_first": [
    {
      "stage": "POST_ACCEPT",
      "source": "scripts/project-c72-verified-staging.mjs",
