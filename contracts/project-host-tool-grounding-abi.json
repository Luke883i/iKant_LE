      "binding": "EXISTING_CALLABLE_NODE_OR_CONTAINER_TOOL",
      "witness": "NODE_EXEC_RESULT_OBSERVED",
      "unknown": "STOP_NODE_UNBOUND"
    },
    {
      "id": "HOST_TOOL_ARGUMENT_COURIER",
      "role": "model passes exact bytes from source tool output into target tool arguments",
      "binding": "EXPLICIT_HOST_TOOL_CALL_ARGUMENT_CARRIES_BYTES",
      "witness": "TARGET_PRIVATE_FILE_READBACK",
      "unknown": "PROBE_REQUIRED_NOT_TRANSFER_FAILED"
    }
  ],
  "carrier_priority": [
    {
      "id": "HOST_TOOL_ARG_RELAY",
      "rank": 1,
      "requires": [
        "GITHUB_SOURCE",
        "NODE_EXEC"
