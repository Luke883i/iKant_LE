      "receiver": "scripts/project-c72-verified-staging.mjs",
      "receive_ops": [
        "init",
        "put",
        "put-local",
        "verify"
      ],
      "physical_protocol": "GitHub fetch_file(ref=SOURCE_HEAD) -> literal tool argument -> Node stdin JSON or mode 0600 private file -> original put/put-local -> independently reopen SHA-1",
      "no_claim": "TOOL_ARGUMENT_COURIER_NOT_NATIVE_PROVIDER_HOOK",
      "on_unknown": "STOP_C72_SOURCE_BRIDGE_UNBOUND_AFTER_OBSERVED_PROBE"
    },
    {
      "id": "SAME_NODE_CALLBACKS",
      "rank": 2,
      "requires": [
        "NODE_EXEC"
