{
  "schema": "ikant-le-c81-runtime-projection-gate/v1",
  "authority": 0,
  "connects": [
    "C72",
    "C77",
    "C78",
    "C79",
    "C81_GIT_REACHABILITY"
  ],
  "product_rule": "MODEL_PROJECTS_EXACT_RUNTIME_BYTES_OR_EMITS_NON_IKANT_DIAGNOSTIC",
  "scope": "POST_CONSENT_EXPERIMENTAL_PER_SUBSTANTIVE_NATIVE_USER_TURN",
  "source_checks": [
    "C81_GIT_REACHABILITY_VERIFIED",
    "SOURCE_HEAD_AND_MANIFEST_BOUND",
    "NO_HOST_ORIGIN_PROMOTION"
