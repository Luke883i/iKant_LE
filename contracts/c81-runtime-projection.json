  "native_host_unknown": [
    "ACTUAL_INGRESS_EVENT_ID",
    "ACTUAL_PRESENTATION_IN_UI",
    "REAL_CROSS_TURN_STATE_WRITER",
    "PERMANENT_OVERLAY_CAPABILITY"
