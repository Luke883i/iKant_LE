    "SAME_INPUT_SHA256",
    "EXACT_OUTPUT_SHA256",
    "CHILD_NODE_EXECUTION_SHAPE",
    "C70_VOICE_SOURCE_NOT_HOST_MODEL_CANDIDATE"
  ],
  "model_cannot": [
    "COMPUTE_IKANT_VOICE",
    "REWRITE_SEALED_OWNER_TEXT",
    "INVENT_NODE_RECEIPT",
    "GENERATE_FALLBACK_IKANT_REPLY",
    "PROMOTE_NATIVE_DELIVERY",
