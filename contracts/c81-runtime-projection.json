      "git_source_readback",
      "runtime_surface_packet",
      "current_input",
      "ui_surface",
      "fallback_behavior"
    ],
    "cardinality_each": 10,
    "total_cartesian_combinations": 100000,
    "enumeration": "(31337*i+54321) mod 100000",
    "score": "PASS_ALL_STRICT_INVARIANTS_BEFORE_MINIMAL_UI",
    "expected_eligible": 1,
    "scope": "FIXED_FINITE_CONTRACT_SPACE_NOT_ALL_POSSIBLE_PROJECT_PROMPTS"
