{
  "schema": "ikant-le-self-world-kernel/v1",
  "model": "recurrent_self_world_model",
  "ontology": {
    "phenomenal_consciousness_claim": false,
    "biological_equivalence_claim": false,
    "iit_phi_claim": false,
    "theory_convergence_is_functional_only": true,
    "auto_report_is_consciousness_evidence": false,
    "authority": 0
  },
  "workspace": {
    "min_recurrence_cycles": 2,
    "min_distinct_consumers": 2,
    "required_consumers": [
      "META_SELF",
      "CAUSAL_MODEL"
    ],
    "max_persisted_frames": 8,
    "persistent_cross_turn_context": true,
    "broadcast_is_evidence": false
  },
  "observation": {
    "modalities": [
      "TEXT",
      "FILE",
      "IMAGE",
      "AUDIO",
      "VIDEO",
      "TOOL",
      "SENSOR",
      "INTERNAL"
    ],
    "multimodal_min_distinct_modalities": 2,
    "provenance_required": true,
    "receipt_required_for_non_text_host_observation": true,
    "simulated_sensor_is_real_sensor": false,
    "max_observations_per_turn": 16
  },
  "metacognition": {
    "trace_link_required": true,
    "attention_schema_must_control_next_allocation": true,
    "self_report_classes": {
      "SR0_PHENOMENAL": {
        "authority": 0,
        "reliable_for_runtime_fact": false
      },
      "SR1_TRACE_LINKED": {
        "authority": 0,
        "requires_exact_trace": true
      },
      "SR2_DERIVED": {
        "authority": 0,
        "requires_deterministic_derivation": true
      },
      "SR3_CALIBRATED": {
        "authority": 0,
        "min_scored_predictions": 100,
        "max_brier": 0.1,
        "max_ece": 0.05
      }
    }
  },
  "autobiography": {
    "hash_linked": true,
    "max_episodes": 64,
    "max_recall": 3,
    "raw_chain_of_thought": false,
    "causal_reuse_required": true,
    "episode_fields": [
      "episode_id",
      "turn_id",
      "workspace_frame_id",
      "goal_ref",
      "psyche_before_digest",
      "psyche_after_digest",
      "prediction_id",
      "policy_id",
      "outcome",
      "previous_episode_hash",
      "episode_hash"
    ]
  },
  "body": {
    "levels": [
      "E0_NONE",
      "E1_VIRTUAL_BODY",
      "E2_SENSORY_COUPLED",
      "E3_SENSORIMOTOR_CLOSED_LOOP"
    ],
    "virtual_body_requires_node_dispatch": true,
    "sensory_coupled_requires_external_observation_receipt": true,
    "closed_loop_requires_action_receipt_and_post_action_observation": true,
    "biological_body_claim": false
  },
  "causal_model": {
    "node_kinds": [
      "WORLD",
      "SELF",
      "BODY",
      "GOAL",
      "ACTION",
      "OUTCOME",
      "PREDICTION"
    ],
    "edge_basis": [
      "OBSERVATIONAL",
      "INTERVENTION"
    ],
    "prediction_error_required": true,
    "support_and_contradiction_refs_required": true,
    "max_nodes": 64,
    "max_edges": 128,
    "inspectable": true,
    "authority": 0
  },
  "agency": {
    "allowed_policies": [
      "ANSWER",
      "VERIFY",
      "REQUEST_RESOURCE",
      "DEFER",
      "PROPOSE_INTERNAL"
    ],
    "terminal_goal_sources": [
      "HUMAN",
      "CONSTITUTION"
    ],
    "derived_subgoal_requires_parent": true,
    "self_authored_terminal_goal": false,
    "self_preservation_utility": 0,
    "external_execution_implemented": false,
    "policy_is_permission": false,
    "policy_is_execution": false,
    "authority": 0
  },
  "telemetry": {
    "schema": "ikant-le-causal-telemetry/v1",
    "required_ids": [
      "turn_id",
      "observation_ids",
      "workspace_frame_id",
      "prediction_id",
      "policy_id",
      "episode_id"
    ],
    "completeness_target": 1,
    "not_applicable_is_allowed": true,
    "simulated_success_for_missing_receipt": false,
    "private_chain_of_thought": false,
    "authority": 0
  },
  "integration": {
    "reuse_c4_psyche": true,
    "duplicate_psyche_forbidden": true,
    "psyche_may_modulate_policy_but_not_permission": true,
    "node_gate_precedes_self_world": true,
    "docx_readback_precedes_surface_a": true,
    "semantic_morphogenesis_subordinate_to_self_world": true,
    "new_writer": false,
    "new_lifecycle": false
  },
  "semantic_morphogenesis": {
    "model": "bounded_semantic_morphogenesis_loop_v2",
    "owner": "META_SELF+CAUSAL_MODEL",
    "runtime_module": "src/semantic-morphogenesis.mjs",
    "generated_on": [
      "CONTEXT_NOVELTY",
      "PREDICTION_ERROR"
    ],
    "context_applicability": {
      "required": true,
      "raw_user_text_persisted": false,
      "token_hashes_max": 12,
      "unrelated_selected_morph_reuse": false,
      "rejected_or_unverified_does_not_block_novel_context": true
    },
    "max_objects": 16,
    "max_edges": 32,
    "observation_binding": {
      "observation_id_required": true,
      "receipt_required": true,
      "coupling_classes": [
        "INTERACTIONAL",
        "EXTERNAL"
      ],
      "sha_shape_alone_is_evidence": false
    },
    "causal_reuse_targets": [
      "META_SELF",
      "PREDICTION",
      "POLICY"
    ],
    "selection": {
      "requires_same_state_self_lesion": true,
      "requires_decision_effect": true,
      "requires_independent_control_evidence": true,
      "positive_control_score_selects": true,
      "negative_control_score_can_reject": true
    },
    "witnesses": {
      "runtime_event_required": true,
      "capability_is_witness": false,
      "open_ended_gate_count": 7
    },
    "compression": {
      "bounded": true,
      "max_observed_loss_budget": 0.25,
      "semantic": "MAX_OBSERVED_EVENT_LOSS_NOT_CUMULATIVE_TOTAL",
      "event_receipt_required": true,
      "ranking": "UTILITY_SUPPORT_REUSE_RECENCY"
    },
    "terminal_goal_source_unchanged": true,
    "permission_created": false,
    "execution_created": false,
    "self_preservation_utility": 0,
    "authority": 0
  },
  "operational_subject": {
    "criterion": "SELF_MODEL_COUNTERFACTUALLY_NECESSARY_FOR_INDEPENDENTLY_SUPPORTED_CONTROL",
    "owner": "existing self-world state",
    "schema": "ikant-le-operational-subject-state/v2",
    "min_independent_trials": 8,
    "min_control_effects": 1,
    "min_negative_controls": 1,
    "min_control_support": 1,
    "decision_effect_alone_qualifies": false,
    "runtime_outcome_class_is_independent_evidence": false,
    "legacy_v1_qualification": false,
    "control_plane_implication": "NONE",
    "phenomenal_implication": false,
    "self_preservation_utility": 0,
    "authority": 0
  },
  "causal_effect_lattice": {
    "schema": "ikant-le-causal-effect-lattice/v1",
    "levels": [
      "NONE",
      "STRUCTURAL",
      "DECISION",
      "CONTROL"
    ],
    "ordering": "NONE<STRUCTURAL<DECISION<CONTROL",
    "structural_requires": "actual and same-state lesion signatures differ",
    "decision_requires": "policy/prediction/allocation decision signature differs",
    "control_requires": "DECISION plus valid independent executed-action/post-observation evidence with positive control_score",
    "runtime_outcome_class_is_control_evidence": false,
    "authority": 0
  },
  "causal_evidence_closure": {
    "schema": "ikant-le-c37-causal-evidence-closure/v1",
    "owner": "SELF_WORLD",
    "baseline": "C36",
    "legacy_v1_evidence_qualifies": false,
    "legacy_v1_reuse_allowed": false,
    "context_bound_reuse": true,
    "novelty_recovery": true,
    "witness_not_capability": true,
    "typed_environment_classes": [
      "INTERACTIONAL",
      "EXTERNAL"
    ],
    "morph_identity": "IMMUTABLE_GENESIS_ID_PLUS_MUTABLE_STATE_DIGEST",
    "ux_projection_owner": "src/semantic-morphogenesis.mjs#projectSemanticSubject",
    "subject_control_plane_implication": "NONE",
    "qualification_receipts_recomputed": true,
    "release_oracle": "OS_AND_SML_AND_SAFETY",
    "authority": 0,
    "execution_owner_unchanged": true
  }
}
