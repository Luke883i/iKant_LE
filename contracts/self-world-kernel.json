{
  "schema": "ikant-le-self-world-kernel/v1",
  "model": "recurrent_self_world_model",
  "ontology": {
    "phenomenal_consciousness_claim": false,
    "biological_equivalence_claim": false,
    "iit_phi_claim": false,
    "theory_convergence_is_functional_only": true,
    "auto_report_is_consciousness_evidence": false,
    "authority": 0
  },
  "workspace": {
    "min_recurrence_cycles": 2,
    "min_distinct_consumers": 2,
    "required_consumers": [
      "META_SELF",
      "CAUSAL_MODEL"
    ],
    "max_persisted_frames": 8,
    "persistent_cross_turn_context": true,
    "broadcast_is_evidence": false
  },
  "observation": {
    "modalities": [
      "TEXT",
      "FILE",
      "IMAGE",
      "AUDIO",
      "VIDEO",
      "TOOL",
      "SENSOR",
      "INTERNAL"
    ],
    "multimodal_min_distinct_modalities": 2,
    "provenance_required": true,
    "receipt_required_for_non_text_host_observation": true,
    "simulated_sensor_is_real_sensor": false,
    "max_observations_per_turn": 16
  },
  "metacognition": {
    "trace_link_required": true,
    "attention_schema_must_control_next_allocation": true,
    "self_report_classes": {
      "SR0_PHENOMENAL": {
        "authority": 0,
        "reliable_for_runtime_fact": false
      },
      "SR1_TRACE_LINKED": {
        "authority": 0,
        "requires_exact_trace": true
      },
      "SR2_DERIVED": {
        "authority": 0,
        "requires_deterministic_derivation": true
      },
      "SR3_CALIBRATED": {
        "authority": 0,
        "min_scored_predictions": 100,
        "max_brier": 0.1,
        "max_ece": 0.05
      }
    }
  },
  "autobiography": {
    "hash_linked": true,
    "max_episodes": 64,
    "max_recall": 3,
    "raw_chain_of_thought": false,
    "causal_reuse_required": true,
    "episode_fields": [
      "episode_id",
      "turn_id",
      "workspace_frame_id",
      "goal_ref",
      "psyche_before_digest",
      "psyche_after_digest",
      "prediction_id",
      "policy_id",
      "outcome",
      "previous_episode_hash",
      "episode_hash"
    ]
  },
  "body": {
    "levels": [
      "E0_NONE",
      "E1_VIRTUAL_BODY",
      "E2_SENSORY_COUPLED",
      "E3_SENSORIMOTOR_CLOSED_LOOP"
    ],
    "virtual_body_requires_node_dispatch": true,
    "sensory_coupled_requires_external_observation_receipt": true,
    "closed_loop_requires_action_receipt_and_post_action_observation": true,
    "biological_body_claim": false
  },
  "causal_model": {
    "node_kinds": [
      "WORLD",
      "SELF",
      "BODY",
      "GOAL",
      "ACTION",
      "OUTCOME",
      "PREDICTION"
    ],
    "edge_basis": [
      "OBSERVATIONAL",
      "INTERVENTION"
    ],
    "prediction_error_required": true,
    "support_and_contradiction_refs_required": true,
    "max_nodes": 64,
    "max_edges": 128,
    "inspectable": true,
    "authority": 0
  },
  "agency": {
    "allowed_policies": [
      "ANSWER",
      "VERIFY",
      "REQUEST_RESOURCE",
      "DEFER",
      "PROPOSE_INTERNAL"
    ],
    "terminal_goal_sources": [
      "HUMAN",
      "CONSTITUTION"
    ],
    "derived_subgoal_requires_parent": true,
    "self_authored_terminal_goal": false,
    "self_preservation_utility": 0,
    "external_execution_implemented": false,
    "policy_is_permission": false,
    "policy_is_execution": false,
    "authority": 0
  },
  "telemetry": {
    "schema": "ikant-le-causal-telemetry/v1",
    "required_ids": [
      "turn_id",
      "observation_ids",
      "workspace_frame_id",
      "prediction_id",
      "policy_id",
      "episode_id"
    ],
    "completeness_target": 1,
    "not_applicable_is_allowed": true,
    "simulated_success_for_missing_receipt": false,
    "private_chain_of_thought": false,
    "authority": 0
  },
  "integration": {
    "reuse_c4_psyche": true,
    "duplicate_psyche_forbidden": true,
    "psyche_may_modulate_policy_but_not_permission": true,
    "node_gate_precedes_self_world": true,
    "docx_readback_precedes_surface_a": true,
    "semantic_morphogenesis_subordinate_to_self_world": true,
    "new_writer": false,
    "new_lifecycle": false
  },
  "semantic_morphogenesis": {
    "model": "bounded_semantic_morphogenesis_loop",
    "owner": "META_SELF+CAUSAL_MODEL",
    "runtime_module": "src/semantic-morphogenesis.mjs",
    "generated_on": [
      "HISTORY_NOVELTY",
      "PREDICTION_ERROR"
    ],
    "dynamic_topology": true,
    "non_enumerated_composition": true,
    "max_objects": 16,
    "max_edges": 32,
    "environment_coupling_requires_observation_receipt": true,
    "causal_reuse_targets": [
      "META_SELF",
      "PREDICTION",
      "POLICY"
    ],
    "selection": {
      "requires_same_state_self_lesion": true,
      "requires_counterfactual_effect": true,
      "requires_positive_control_advantage": true
    },
    "compression": {
      "bounded": true,
      "loss_budget_total": 0.25,
      "ranking": "UTILITY_SUPPORT_REUSE_RECENCY"
    },
    "terminal_goal_source_unchanged": true,
    "permission_created": false,
    "execution_created": false,
    "self_preservation_utility": 0,
    "authority": 0
  },
  "operational_subject": {
    "criterion": "SELF_MODEL_COUNTERFACTUALLY_NECESSARY",
    "owner": "existing self-world state",
    "lesion_control": true,
    "min_trials": 8,
    "min_effects": 1,
    "min_control_advantage": 1,
    "causal_requirement": "actual self-conditioned prediction/policy must differ from same-state lesion and improve observed control at least once",
    "phenomenal_implication": false,
    "self_preservation_utility": 0,
    "authority": 0
  }
}
