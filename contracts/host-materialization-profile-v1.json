  },
  "mechanisms": [
    {
      "id": "M0_FRAME_OWNER_DERIVATION",
      "meaning": "One authority-zero host consumption frame is derived from existing runtime/session owners; prose and UI do not reconstruct state."
    },
    {
      "id": "M1_ALL_PHASE_SHELL",
      "meaning": "Baseline, bootstrap, limited and ACTIVE results all expose an owner-rendered ASCII shell for host consumption."
    },
    {
      "id": "M2_EXACT_SHELL_BYTES",
      "meaning": "Host consumes exact shell bytes with SHA-256/length verification; model/UI reframing is forbidden."
    },
    {
      "id": "M3_SHELL_CONTINUITY_BINDING",
      "meaning": "Frames bind source/runtime/session plus stable shell/style context; per-turn frames may change while continuity identity remains stable."
    },
    {
      "id": "M4_LIFECYCLE_FAIL_CLOSED",
      "meaning": "Display state and claim class are projections only; host materialization cannot promote ACTIVE/native/product/control states."
    },
    {
      "id": "M5_RUNTIME_ROUTE_BINDING",
      "meaning": "Runtime-turn frames expose runtime-owned turn/dispatch evidence when present and never replace the C53 physical route predicate."
    },
    {
      "id": "M6_ARTIFACT_BYTE_HANDOFF",
      "meaning": "Required Surface-B artifacts are byte-transported to the host app only after local digest/readback verification."
    },
    {
      "id": "M7_ARTIFACT_BEFORE_SHELL",
      "meaning": "When Surface-B presentation is required, verified artifact bytes are materialized before the ASCII shell containing Surface A."
    },
    {
      "id": "M8_PROMISE_PROFILE_PROJECTION",
      "meaning": "All 36 C29 ontological promise atoms are source-bound and projected into an explicit application class instead of disappearing into prose."
    },
    {
      "id": "M9_EXTERNAL_GAP_VECTOR",
      "meaning": "Host-only admission/native/presentation/persistence facts remain explicit unmet or externally witnessed obligations and cannot be inferred from repository PASS."
    },
    {
      "id": "M10_HOST_APP_CONSUMES_FRAME",
      "meaning": "The reference host UX consumes the frame and verified artifact payloads directly; it does not infer from stdout, filenames or status strings."
    },
    {
      "id": "M11_ZERO_NEW_AUTHORITY",
      "meaning": "Frame, app payload and UX remain authority-zero, non-persisted projections and create no lifecycle/state/planner/turn owner."
    }
  ],
